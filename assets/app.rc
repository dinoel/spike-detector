// Windows resources of the tray monitor, compiled into it by build.rs.

// Icon IDs: keep in sync with the ICON_* constants in src/win/tray.rs.
// Explorer shows the icon with the lowest ID as the executable's own.
1 ICON "idle.ico"
2 ICON "alert.ico"
3 ICON "paused.ico"

#define DESCRIPTION "spike-detector"
#define FILENAME "spike-detector.exe"
#include "version.rc"
