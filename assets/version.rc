// Version info shared by both executables. The including file defines
// DESCRIPTION and FILENAME; VERSION_* macros come from Cargo.toml via build.rs.
// FileDescription is also the app name Windows shows on notifications.

1 VERSIONINFO
FILEVERSION     VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION  VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
FILEOS          0x40004  // VOS_NT_WINDOWS32
FILETYPE        0x1      // VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", DESCRIPTION
            VALUE "ProductName", "spike-detector"
            VALUE "OriginalFilename", FILENAME
            VALUE "FileVersion", VERSION_STRING
            VALUE "ProductVersion", VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
